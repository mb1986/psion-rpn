RPNOPER:(OP$)
LOCAL TMP

IF OP$ = "ENT"
    T=Z
    Z=Y
    Y=X
    NL%=0
ELSEIF OP$ = "+"
    X=Y+X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "-"
    X=Y-X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "*"
    X=Y*X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "/"
    X=Y/X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "%"
    X=Y*X/100
    NL%=1
ELSEIF OP$ = "XY"
    TMP=X
    X=Y
    Y=TMP
    NL%=1
ELSEIF OP$ = "Rv"
    TMP=X
    X=Y
    Y=Z
    Z=T
    T=TMP
    NL%=1
ENDIF
