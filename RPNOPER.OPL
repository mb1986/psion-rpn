RPNOPER:(OP$)

IF OP$ = "ENT"
    T=Z
    Z=Y
    Y=X
    NL%=0
ELSEIF OP$ = "+"
    X=Y+X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "-"
    X=Y-X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "*"
    X=Y*X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "/"
    X=Y/X
    Y=Z
    Z=T
    NL%=1
ELSEIF OP$ = "%"
    X=Y*X/100
    NL%=1
ENDIF
