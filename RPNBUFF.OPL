RPNBUFF:(C$)
LOCAL NC$(1),I%,T$(1),BF$(1)

NC$=C$
I%=1
IF C$ = "."
    WHILE I% <= LEN(B$)
        T$=MID$(B$,I%,1)
        IF T$="." OR T$="E"
            NC$=""
            BREAK
        ENDIF
        I%=I%+1
    ENDWH
ELSEIF C$ = "E"
    WHILE I% <= LEN(B$)
        T$=MID$(B$,I%,1)
        IF T$="E"
            NC$=""
            BREAK
        ENDIF
        I%=I%+1
    ENDWH
ENDIF

IF NC$="E" AND LEN(B$)>0
    IF VAL(B$)=0
        B$="1E"
        RETURN
    ENDIF
ENDIF

B$=B$+NC$

REM 1<-E->0
REM 0<-.

T$=""
BF$=LEFT$(B$,1)

IF BF$="."
    T$="0"
ELSEIF BF$="E"
    T$="1"
ENDIF

B$=T$+B$
